---
# Static-analysis baseline for apl1 (FH-09).
#
# This is an optional developer check, not a build dependency or CI gate.
# Checks are intentionally limited to high-signal families; the exclusions
# below are documented in work-items/foundation-hardening/FH-09-static-analysis-baseline.md.
#
# Narrow C23 false positive: clang-analyzer-valist.Uninitialized does not
# recognize C23's __builtin_c23_va_start when a va_list is forwarded to a
# helper.
# misc-const-correctness and modernize-use-nullptr do not run on C in
# clang-tidy 21. Use the C-capable parameter checks below; general local
# const/constexpr choices still need review.
Checks: >
  -*,
  clang-analyzer-*,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  -clang-analyzer-valist.Uninitialized,
  bugprone-*,
  -bugprone-reserved-identifier,
  -bugprone-easily-swappable-parameters,
  cert-*,
  -cert-err33-c,
  -cert-dcl37-c,
  -cert-dcl51-cpp,
  performance-*,
  portability-*,
  misc-include-cleaner,
  readability-avoid-const-params-in-decls,
  readability-non-const-parameter
CheckOptions:
  # Enforce unused includes without demanding direct includes for every symbol
  # intentionally exposed by this project's public and internal umbrella headers.
  misc-include-cleaner.MissingIncludes: false
HeaderFilterRegex: '.*/(src|tests)/.*'
FormatStyle: file
UseColor: false
WarningsAsErrors: ''
