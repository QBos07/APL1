
include_guard(GLOBAL)

include(ExternalProject)
include(GNUInstallDirs)

find_package(PkgConfig QUIET)

# --------------------------------------------------
# System installation
# --------------------------------------------------

if(PkgConfig_FOUND)
    pkg_check_modules(CRITERION QUIET IMPORTED_TARGET criterion)
endif()

if(CRITERION_FOUND)

    message(STATUS "Using system Criterion: ${CRITERION_VERSION}")

    add_library(Criterion::Criterion ALIAS PkgConfig::CRITERION)

else()

    message(STATUS "System Criterion not found; fetching upstream")

    find_program(MESON_EXECUTABLE meson REQUIRED)
    find_program(NINJA_EXECUTABLE ninja REQUIRED)

    set(CRITERION_INSTALL_DIR
            "${CMAKE_BINARY_DIR}/_deps/criterion-install"
    )

    set(CRITERION_LIBRARY
            "${CRITERION_INSTALL_DIR}/lib/libcriterion${CMAKE_SHARED_LIBRARY_SUFFIX}"
    )

    set(CRITERION_INCLUDE_DIR
            "${CRITERION_INSTALL_DIR}/include"
    )

    # Create include directory during CMake configuration.
    file(MAKE_DIRECTORY "${CRITERION_INCLUDE_DIR}")

    # --------------------------------------------------
    # Build and install Criterion
    # --------------------------------------------------

    ExternalProject_Add(criterion_external

            GIT_REPOSITORY
            https://github.com/Snaipe/Criterion.git

            GIT_TAG
            v2.4.2

            GIT_SHALLOW TRUE

            CONFIGURE_COMMAND
            "${MESON_EXECUTABLE}" setup
            <BINARY_DIR>
            <SOURCE_DIR>
            --prefix=${CRITERION_INSTALL_DIR}
            --libdir=lib
            --default-library=shared
            --buildtype=release
            --backend=ninja

            BUILD_COMMAND
            "${MESON_EXECUTABLE}" compile -C <BINARY_DIR>

            INSTALL_COMMAND
            "${MESON_EXECUTABLE}" install -C <BINARY_DIR>

            # Important for Ninja:
            # The library is generated by the INSTALL step.
            INSTALL_BYPRODUCTS
            "${CRITERION_LIBRARY}"
    )

    # --------------------------------------------------
    # Imported target
    # --------------------------------------------------

    add_library(criterion UNKNOWN IMPORTED GLOBAL)

    set_target_properties(criterion PROPERTIES
            IMPORTED_LOCATION
            "${CRITERION_LIBRARY}"

            INTERFACE_INCLUDE_DIRECTORIES
            "${CRITERION_INCLUDE_DIR}"
    )

    # Build Criterion before targets linking against it.
    add_dependencies(criterion criterion_external)

    add_library(Criterion::Criterion ALIAS criterion)

endif()
